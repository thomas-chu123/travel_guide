# Runtime
APP_ENV=development
API_PORT=8000
WEB_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Development default: GSI optimized vector tiles. Replace with an owned
# PMTiles/CDN style URL before production release.
VITE_MAP_STYLE_URL=https://gsi-cyberjapan.github.io/optimal_bvmap/style/std.json

# Local database by default. PostgreSQL/PostGIS can be selected later only by
# changing DATABASE_URL and adding the spatial repository implementation.
DATABASE_URL=sqlite:///./data/tokyo_event_map.db

# Map and routing providers
MAP_STYLE_URL=
PMTILES_URL=
VALHALLA_URL=http://valhalla:8002

# Optional data-discovery and enrichment services
SEARXNG_URL=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=

# Google Places: used only by the FastAPI proxy in a later phase
GOOGLE_MAPS_API_KEY=

# Supabase REST admin proxy. Keep the secret key only in the backend runtime.
SUPABASE_PUBLIC_URL=
SUPABASE_SECRET_KEY=
# Required by the /api/v1/supabase routes through X-Supabase-Admin-Token.
SUPABASE_ADMIN_TOKEN=
# Comma-separated tables that this backend may operate on. Empty disables table operations.
SUPABASE_ALLOWED_TABLES=
